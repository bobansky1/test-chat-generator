APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=true
# Generate a stable random secret with at least 32 characters. Back it up with the DB.
LICENSE_SECRET=
# Receipt settings supplied by your YooKassa store/accountant; leave empty if not used.
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
DB_PATH=data/billing.sqlite
# Public HTTPS origin for canonical URLs, sitemap and pre-rendered SEO pages.
# Set both to the same origin before npm run build.
SITE_URL=
VITE_SITE_URL=
